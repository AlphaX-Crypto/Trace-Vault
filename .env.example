# ==============================================================================
# TRACEVAULT V2 — MASTER ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Operating Environment: 'development' | 'test' | 'production'
NODE_ENV=development

# Service Network Ports
PORT=5000
BACKEND_PORT=5000
INTELLIGENCE_PORT=8000
FRONTEND_PORT=5173

# CORS Origin (Frontend domain)
CORS_ORIGIN=http://localhost:5173

# Reverse Proxy Trust (Set to true when behind Nginx or AWS ALB)
TRUST_PROXY=false

# PostgreSQL Database Connection
# In Docker compose: postgresql://postgres:postgres@postgres:5432/tracevault
# Local development: postgresql://postgres:postgres@localhost:5432/tracevault
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tracevault

# Python Intelligence Engine Gateway URL
PYTHON_INTELLIGENCE_URL=http://localhost:8000
INTELLIGENCE_ENGINE_URL=http://localhost:8000
INTELLIGENCE_TIMEOUT=15000

# Authentication & Session Security (Minimum 32 characters in production)
JWT_SECRET=tracevault_dev_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=2h

# Rate Limiting Configuration (Ingress defense)
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_ANALYZE_MAX=20
RATE_LIMIT_DISCLOSURE_MAX=30
RATE_LIMIT_GENERAL_MAX=300

