# ==============================================================================
# TRACEVAULT V2 — BACKEND CONFIGURATION
# ==============================================================================

# Node Environment: 'development' | 'test' | 'production'
NODE_ENV=development
PORT=5000
BACKEND_PORT=5000

# CORS Allowed Origin
# Development: http://localhost:5173
# Production: https://tracevault.gov.in (Must NOT be wildcard * in production)
CORS_ORIGIN=http://localhost:5173

# Set to '1' or 'true' when deployed behind reverse proxy (Nginx, Cloudflare, AWS ALB)
TRUST_PROXY=false

# JWT Authentication Configuration
# In PRODUCTION, JWT_SECRET must be at least 32 characters long and unique.
JWT_SECRET=tracevault_dev_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=2h

# Python Intelligence Engine Gateway
INTELLIGENCE_ENGINE_URL=http://localhost:8000
PYTHON_INTELLIGENCE_URL=http://localhost:8000
INTELLIGENCE_TIMEOUT=15000

# PostgreSQL Persistence
# Development (local docker): postgresql://postgres:postgres@localhost:5432/tracevault
# Test (in-memory pg-mem): leave DATABASE_URL unset with USE_PG_MEM=true
# Production: postgresql://tv_app_user:REPLACE_WITH_STRONG_PASSWORD@db-host:5432/tracevault?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tracevault

# Rate Limiting Configuration (Max requests per window)
RATE_LIMIT_LOGIN_MAX=10          # per 15 min
RATE_LIMIT_ANALYZE_MAX=20        # per 10 min
RATE_LIMIT_DISCLOSURE_MAX=30     # per 10 min
RATE_LIMIT_GENERAL_MAX=300       # per 15 min

